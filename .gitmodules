[submodule ".registry"]
	path = .registry
	url = https://github.com/tkragholm/tkragholm.r-universe.dev
	branch = HEAD
[submodule "fastsas"]
	path = fastsas
	url = https://github.com/tkragholm/sas7bdat-parser-rs
	subdir = crates/r-plugin
[submodule "fastsasconvert"]
	path = fastsasconvert
	url = https://github.com/tkragholm/sas7bdat-parser-rs
	subdir = crates/r-convert-plugin
